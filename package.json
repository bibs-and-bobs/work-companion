{
  "name": "work-companion",
  "productName": "Work Companion",
  "version": "0.4.0",
  "description": "A small desktop companion for the work day.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.bibs-and-bobs.work-companion",
    "productName": "Work Companion",
    "copyright": "MIT License",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Work-Companion-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Work Companion ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
